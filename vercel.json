{
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@2.x",
      "includeFiles": [
        "publish_output/**"
      ]
    }
  },
  "builds": [
    {
      "src": "YourProject.csproj",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "dotnet publish -c Release -o publish_output"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}