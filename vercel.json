{
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@2.x",
      "includeFiles": [
        "bin/Release/netcoreapp6.0/publish/**" // .NET Core publish çýktýnýzýn yolu
      ]
    }
  },
  "builds": [
    {
      "src": "YourProject.csproj", // Projenizin .csproj dosyasýnýn yolu
      "use": "@vercel/dotnet" // veya .NET Core projenizi publish etmek için kendi komutunuz
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html" // veya eðer tüm trafik api'ye yönlendirilecekse "/api"
    }
  ]
}