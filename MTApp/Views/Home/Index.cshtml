@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mb-5">
    <h1 class="display-4 text-primary font-weight-bold">MTApp İnsan Kaynakları Yönetim Sistemine Hoş Geldiniz!</h1>
    <p class="lead text-muted">İK süreçlerinizi kolaylaştıran ve verimliliği artıran kapsamlı çözümünüz.</p>
</div>

<div class="row g-4 mb-5">
    <div class="col-lg-4 col-md-6 col-sm-12">
        <div class="card h-100 shadow-lg border-0 rounded-4 overflow-hidden transform-on-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-circle bg-primary-subtle text-primary me-3">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                    <h5 class="card-title mb-0 text-primary">Personel Yönetimi</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Tüm personel bilgilerinizi tek bir yerden kolayca yönetin, ekleyin, düzenleyin ve silin.</p>
                <div class="mt-auto">
                    <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold">
                        Git <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6 col-sm-12">
        <div class="card h-100 shadow-lg border-0 rounded-4 overflow-hidden transform-on-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-circle bg-success-subtle text-success me-3">
                        <i class="fas fa-calendar-alt fa-2x"></i>
                    </div>
                    <h5 class="card-title mb-0 text-success">İzin Takibi</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Personel izin taleplerini hızlıca takip edin, onaylayın veya reddedin.</p>
                <div class="mt-auto">
                    <a asp-controller="Leaves" asp-action="Index" class="btn btn-outline-success rounded-pill px-4 py-2 fw-bold">
                        Git <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6 col-sm-12">
        <div class="card h-100 shadow-lg border-0 rounded-4 overflow-hidden transform-on-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-circle bg-info-subtle text-info me-3">
                        <i class="fas fa-bullhorn fa-2x"></i>
                    </div>
                    <h5 class="card-title mb-0 text-info">Duyurular</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Şirket içi duyuruları kolayca yayınlayın ve tüm çalışanlara ulaştırın.</p>
                <div class="mt-auto">
                    <a asp-controller="Announcements" asp-action="Index" class="btn btn-outline-info rounded-pill px-4 py-2 fw-bold">
                        Git <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6 col-sm-12">
        <div class="card h-100 shadow-lg border-0 rounded-4 overflow-hidden transform-on-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-circle bg-warning-subtle text-warning me-3">
                        <i class="fas fa-money-bill-wave fa-2x"></i>
                    </div>
                    <h5 class="card-title mb-0 text-warning">Avans Talepleri</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Personel avans taleplerini yönetin ve durumlarını güncelleyin.</p>
                <div class="mt-auto">
                    <a asp-controller="Advances" asp-action="Index" class="btn btn-outline-warning rounded-pill px-4 py-2 fw-bold">
                        Git <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6 col-sm-12">
        <div class="card h-100 shadow-lg border-0 rounded-4 overflow-hidden transform-on-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-circle bg-danger-subtle text-danger me-3">
                        <i class="fas fa-graduation-cap fa-2x"></i>
                    </div>
                    <h5 class="card-title mb-0 text-danger">Eğitim Yönetimi</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Şirket içi ve dışı eğitimleri planlayın ve takip edin.</p>
                <div class="mt-auto">
                    <a asp-controller="Trainings" asp-action="Index" class="btn btn-outline-danger rounded-pill px-4 py-2 fw-bold">
                        Git <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6 col-sm-12">
        <div class="card h-100 shadow-lg border-0 rounded-4 overflow-hidden transform-on-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-circle bg-secondary-subtle text-secondary me-3">
                        <i class="fas fa-building fa-2x"></i>
                    </div>
                    <h5 class="card-title mb-0 text-secondary">Departmanlar</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Şirket departmanlarını yönetin ve organizasyon yapısını düzenleyin.</p>
                <div class="mt-auto">
                    <a asp-controller="Departments" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-bold">
                        Git <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6 col-sm-12">
        <div class="card h-100 shadow-lg border-0 rounded-4 overflow-hidden transform-on-hover">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="icon-circle bg-dark-subtle text-dark me-3">
                        <i class="fas fa-user-tag fa-2x"></i>
                    </div>
                    <h5 class="card-title mb-0 text-dark">Unvanlar</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Şirket içindeki tüm unvanları yönetin ve tanımlayın.</p>
                <div class="mt-auto">
                    <a asp-controller="Titles" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-bold">
                        Git <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .card {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    }

        .card.transform-on-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.2) !important;
        }

    .bg-primary-subtle {
        background-color: #cfe2ff !important;
    }

    .bg-success-subtle {
        background-color: #d1e7dd !important;
    }

    .bg-info-subtle {
        background-color: #cff4fc !important;
    }

    .bg-warning-subtle {
        background-color: #fff3cd !important;
    }

    .bg-danger-subtle {
        background-color: #f8d7da !important;
    }

    .bg-secondary-subtle {
        background-color: #e2e3e5 !important;
    }

    .bg-dark-subtle {
        background-color: #ced4da !important;
    }
    .text-dark {
        color: #212529 !important;
    }
</style>
