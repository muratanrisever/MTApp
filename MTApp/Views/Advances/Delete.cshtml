@model MTApp.Models.Advance

@{
    ViewData["Title"] = "Avans Talebini Sil";
}

<h1 class="text-danger mb-4">Silmek İstediğinizden Emin Misiniz?</h1>

<h3 class="mb-3">Bu avans talebini silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</h3>
<div>
    <h4 class="mb-3">Avans Talebi - @Html.DisplayFor(model => model.Employee!.FirstName) @Html.DisplayFor(model => model.Employee!.LastName)</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Employee)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Employee!.FirstName) @Html.DisplayFor(model => model.Employee!.LastName)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Amount)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Amount)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.RequestDate)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.RequestDate)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-9">
            @if (Model.Status == MTApp.Models.AdvanceStatus.Approved)
            {
                <span class="badge bg-success">Onaylandı</span>
            }
            else if (Model.Status == MTApp.Models.AdvanceStatus.Pending)
            {
                <span class="badge bg-warning">Beklemede</span>
            }
            else
            {
                <span class="badge bg-danger">Reddedildi</span>
            }
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger rounded-pill shadow-sm">
            <i class="fas fa-trash-alt"></i> Sil
        </button>
        <a asp-action="Index" class="btn btn-secondary rounded-pill shadow-sm">
            <i class="fas fa-arrow-left"></i> Listeye Geri Dön
        </a>
    </form>
</div>