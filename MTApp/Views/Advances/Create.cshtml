@model MTApp.Models.Advance

@{
    ViewData["Title"] = "Yeni Avans Talebi Oluştur";
}

<h1 class="text-primary mb-4">Yeni Avans Talebi</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-group mb-3">
                <label asp-for="EmployeeId" class="control-label"></label>
                <select asp-for="EmployeeId" class="form-control rounded-pill" asp-items="ViewBag.EmployeeId">
                    <option value="">Personel Seçiniz</option>
                </select>
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Amount" class="control-label"></label>
                <input asp-for="Amount" class="form-control rounded-pill" type="number" step="0.01" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control rounded-lg" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <!-- RequestDate ve Status alanları otomatik ayarlanacağı için formda gösterilmez -->
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary rounded-pill shadow-sm">
                    <i class="fas fa-save"></i> Oluştur
                </button>
                <a asp-action="Index" class="btn btn-secondary rounded-pill shadow-sm">
                    <i class="fas fa-arrow-left"></i> Listeye Geri Dön
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}