@model IEnumerable<MTApp.Models.Advance>

@{
    ViewData["Title"] = "Avanslar";
}

<h1 class="text-primary mb-4">Avanslar</h1>

<p>
    <a asp-action="Create" class="btn btn-success rounded-pill shadow-sm">
        <i class="fas fa-plus-circle"></i> Yeni Avans Talebi Oluştur
    </a>
    <a asp-action="Index" asp-controller="Home" class="btn btn-secondary rounded-pill shadow-sm ms-2">
        <i class="fas fa-arrow-left"></i> Anasayfaya Geri Dön
    </a>
</p>

<div class="table-responsive rounded-lg shadow-sm">
    <table class="table table-hover table-striped">
        <thead class="bg-primary text-white">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Employee)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Amount)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.RequestDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Description)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Employee!.FirstName) @Html.DisplayFor(modelItem => item.Employee!.LastName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Amount)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.RequestDate)
                    </td>
                    <td>
                        @if (item.Status == MTApp.Models.AdvanceStatus.Approved)
                        {
                            <span class="badge bg-success">Onaylandı</span>
                        }
                        else if (item.Status == MTApp.Models.AdvanceStatus.Pending)
                        {
                            <span class="badge bg-warning">Beklemede</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Reddedildi</span>
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning rounded-pill">
                            <i class="fas fa-edit"></i> Düzenle
                        </a> |
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info rounded-pill">
                            <i class="fas fa-info-circle"></i> Detaylar
                        </a> |
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger rounded-pill">
                            <i class="fas fa-trash-alt"></i> Sil
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>